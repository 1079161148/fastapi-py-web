# 生产环境变量模板。复制为 deploy/.env 后填写，绝不要提交到仓库。
#
#   cp deploy/.env.prod.example deploy/.env
#   python -c "import secrets; print(secrets.token_hex(32))"   # 生成 JWT_SECRET
#
# 与开发环境（backend/.env）的三处关键差异：
#   1. APP_ENV=production  → cookie 带 Secure，必须先有 HTTPS
#   2. TRUST_PROXY_HEADERS=true → 否则限流把所有请求都算成 Nginx 这一个 IP
#   3. 数据库/Redis 用 compose 内网主机名（postgres:5432 / redis:6379），不是 localhost

# ===== 运行 =====
APP_ENV=production
LOG_LEVEL=INFO
# uvicorn 进程数：建议 = CPU 核数，上限 4（再多会同时压满模型配额）
API_WORKERS=2
# Nginx 对外端口
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# 备份：间隔（秒）与保留天数
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# ===== 认证（必填，>=32 字符）=====
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# ===== 数据库（compose 内网）=====
POSTGRES_USER=aics
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=aics
# 备份脚本连库用（容器内会被 compose 覆盖为 postgres）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql+asyncpg://aics_app:change-me-app@postgres:5432/aics
# 迁移用超管连接；运行时禁止使用（RLS 对超管无效）
MIGRATION_DATABASE_URL=postgresql+asyncpg://aics:change-me-postgres@postgres:5432/aics

# ===== 缓存 =====
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0

# ===== AI 网关 =====
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=
AI_RERANK_MODEL=
# 向量维度必须与嵌入模型一致，且与库里已建的列匹配（迁移 0012 起为 2048）
AI_EMBEDDING_DIM=2048
AI_TIMEOUT_SECONDS=120

# ===== 知识库与检索 =====
RAG_ENABLED=true
CHUNK_STRATEGY=by_heading
RETRIEVAL_RECALL_K=50
RETRIEVAL_TOP_K=5

# ===== 文件存储：单机用 local，落在 uploads_data 卷 =====
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/uploads
UPLOAD_MAX_MB=20

# ===== 限流（生产必须开启）=====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_CHAT=30
RATE_LIMIT_WEBHOOK=600
# 反代后真实 IP 来自 X-Forwarded-For；只有应用端口不可直连时才可打开
TRUST_PROXY_HEADERS=true

# ===== 告警（可选：填钉钉/飞书/Slack 机器人 webhook）=====
ALERT_WEBHOOK_URL=

# ===== 渠道接入（可选，留空即该渠道禁用）=====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
SMTP_HOST=
IMAP_HOST=

# ===== 用量成本（可选：按供应商账单填，留 0 则只记用量不计成本）=====
USAGE_PRICE_PROMPT_PER_1K=0
USAGE_PRICE_COMPLETION_PER_1K=0
