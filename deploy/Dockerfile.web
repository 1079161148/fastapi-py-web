# 前端静态构建 + Nginx 反代。
#
# 构建上下文必须是仓库根目录：
#   docker build -f deploy/Dockerfile.web -t aics-web:prod .
#
# 前端所有请求用相对路径 /api，生产同源反代即可，不需要在构建期注入后端地址。

FROM node:22-alpine AS build

# 锁文件是 lockfileVersion 9.0（pnpm 9）；corepack 按 packageManager 字段解析，
# 这里显式装大版本，避免 corepack 拉取镜像里不存在的版本
RUN npm install -g pnpm@9

WORKDIR /app
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ ./
RUN pnpm build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
# snippets/ 与 conf.d/ 都要进镜像：80 与 443 共用 location，缺了会 emerg 起不来
COPY deploy/nginx/conf.d/ /etc/nginx/conf.d/
COPY deploy/nginx/snippets/ /etc/nginx/snippets/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
