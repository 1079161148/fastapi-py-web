# ===== AI 网关（OpenAI 兼容协议，详见设计文档 3.1）=====
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 可选：独立嵌入模型端点，缺省回退到上面三项
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=
# 可选：rerank 模型，缺省关闭 rerank
AI_RERANK_MODEL=
# 可选：单次对话请求超时（秒），默认 120
AI_TIMEOUT_SECONDS=120

# ===== 对话 =====
# 组装 prompt 时携带的历史消息条数上限，默认 20
CHAT_HISTORY_LIMIT=20
# 访客会话有效期（天），与 cookie Max-Age 对齐，默认 30
GUEST_SESSION_TTL_DAYS=30

# ===== 知识库与检索（M3）=====
# 向量维度：必须与嵌入模型实际维度一致，建表后不可直接改（需迁移重建列）
AI_EMBEDDING_DIM=2048
# 分块策略：by_heading（按 Markdown 标题）/ fixed_window（固定窗口）
CHUNK_STRATEGY=by_heading
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# 两路召回各取 RECALL_K 条，RRF 融合后取 TOP_K 条进入 prompt
RETRIEVAL_RECALL_K=50
RETRIEVAL_TOP_K=5
# 关闭后跳过检索，退化为纯模型回答
RAG_ENABLED=true

# ===== 语音（M5，可选：缺省则语音输入/语音回复不可用，文字链路不受影响）=====
# 转写（ASR）是语音消息的入口：未配置时上传接口直接 503，并提示缺哪个变量
AI_TRANSCRIPTION_MODEL=
# 以下两项缺省回退 AI_API_KEY / AI_BASE_URL（模型必须单独指定）
AI_TRANSCRIPTION_API_KEY=
AI_TRANSCRIPTION_BASE_URL=
AI_TRANSCRIPTION_TIMEOUT_SECONDS=60
# 合成（TTS）是可选增强：未配置时语音回复自动跳过，文字照常返回
AI_TTS_MODEL=
AI_TTS_API_KEY=
AI_TTS_BASE_URL=
AI_TTS_VOICE=alloy
AI_TTS_TIMEOUT_SECONDS=30
# 单条回复超过该字数就不合成（截断成"说到一半"体验更差）
AI_TTS_MAX_CHARS=800
# 单条语音时长与大小上限（转写按分钟计费，是成本大头）
VOICE_MAX_SECONDS=60
VOICE_MAX_MB=8
# 音频播放地址有效期（秒）：<audio> 无法带 Authorization，只能用短时令牌
VOICE_AUDIO_URL_TTL_SECONDS=3600

# ===== 文件存储 =====
# local：落本地目录（开发/单机）；minio：对象存储后端，尚未实现
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/uploads
UPLOAD_MAX_MB=20

# ===== 数据库 / 缓存 / 对象存储 =====
# 宿主机端口错峰映射：本机 5432/6379/6381 已被其他项目占用，见设计文档第 14 章
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aics
# 应用运行时连接：aics_app 角色（非超管，受 RLS 约束，见设计文档 8/9.2）
APP_DB_PASSWORD=aics_app
DATABASE_URL=postgresql+asyncpg://aics_app:aics_app@localhost:55432/aics
# 迁移连接：超管，仅 Alembic 使用（RLS 对超管无效，故运行时禁止用此连接）
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/aics
REDIS_URL=redis://localhost:56379/0
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000

# ===== 认证 =====
# 必填（所有环境）：长度 ≥32，缺失或过短时应用启动即报错（见 app/core/config.py）
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# ===== 运行 =====
APP_ENV=development
LOG_LEVEL=INFO

# ===== 渠道接入（M4，可选：缺省该渠道自动禁用，不影响其他渠道）=====
# 微信：回调地址需带 ?account=gh_xxx（公众号原始 ID），配置里的 external_account_id 必须一致
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 公众平台"服务器配置"里自己填的 Token，验签必需
WECHAT_TOKEN=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 机器人发消息用；留空回退到 DINGTALK_APP_KEY
DINGTALK_ROBOT_CODE=
# 邮件出站
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人；留空回退到 SMTP_USERNAME
SMTP_FROM=
# 邮件入站轮询
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
# 轮询间隔（秒）：>=60 按分钟跑；<60 按 30s 跑（低于 30s 易被判异常）
EMAIL_POLL_SECONDS=60
EMAIL_POLL_BATCH=20

# ===== 人工接管（M6）=====
# AI 答不了时在回答末尾输出标记，系统据此建单；关闭后只保留关键词触发
HANDOFF_AI_MARKER_ENABLED=true
# 命中这些词直接建单（逗号分隔，留空即关闭关键词触发）
HANDOFF_KEYWORDS=转人工,人工客服,找人工,要人,真人客服
# 坐席 SSE 心跳间隔（秒）：需小于 Nginx 默认 60s 空闲断连
AGENT_STREAM_HEARTBEAT_SECONDS=20
# 访客会话过期后，再保留多少天才连会话与消息一起物理删除
GUEST_CLEANUP_RETENTION_DAYS=90

# ===== 用量成本（M7，可选）=====
# 价格按供应商账单填写；留空/0 表示只记用量不计成本（看板显示 0，不猜价目）
# 币种由部署方决定，系统不做换算
USAGE_PRICE_PROMPT_PER_1K=0
USAGE_PRICE_COMPLETION_PER_1K=0
# 嵌入/重排按字符数计价（本系统不含 tokenizer，用字符数作为可复现的近似口径）
USAGE_PRICE_EMBEDDING_PER_1K_CHARS=0
USAGE_PRICE_RERANK_PER_1K_CHARS=0
# ASR 按音频分钟、TTS 按合成字符数
USAGE_PRICE_ASR_PER_MINUTE=0
USAGE_PRICE_TTS_PER_1K_CHARS=0

# 告警：留空则只写结构化日志；配置后额外推送 JSON（钉钉/飞书/Slack 机器人）
ALERT_WEBHOOK_URL=

# ===== 限流（M8）=====
# 关闭后所有阈值失效（仅建议在压测/排障时关闭）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# 默认兜底（按 IP）、认证接口（按 IP）、对话（按用户/访客）、渠道回调（按租户）
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_CHAT=30
RATE_LIMIT_WEBHOOK=600
# 只有确认应用端口仅反代可达时才打开：信任 X-Forwarded-For 等于让客户端可伪造 IP
TRUST_PROXY_HEADERS=false
